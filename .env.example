# --- Video providers ---
# Primary provider to try first: coverr | pixabay | pexels | local
# Fallback order is always: coverr -> pixabay -> pexels -> local, regardless of
# which one is primary. The server can start with none of the API keys set as
# long as LOCAL_VIDEOS_DIR contains at least one video file.
VIDEO_PROVIDER=pexels
COVERR_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
# only used by the "local" provider - a folder of your own video files
LOCAL_VIDEOS_DIR=./assets/videos

# --- AI filmmaking platform (optional) ---
# short-film | documentary | shorts | commercial
PROJECT_TYPE=shorts
# local generative-model servers - leave empty to skip and fall back to
# the video providers above / the default Kokoro voices
COMFYUI_URL=
LTX_VIDEO_URL=
WAN_VIDEO_URL=
# local LLM for real script generation (e.g. Ollama at http://localhost:11434)
# leave empty to use the built-in template-based story engine
OLLAMA_URL=
# optional TTS API fallback alongside the built-in Kokoro voices
ELEVENLABS_API_KEY=

LOG_LEVEL=trace # trace, debug, info, warn, error, fatal, silent
WHISPER_VERBOSE=true
PORT=3123
DEV=true # local development mode
DATA_DIR_PATH= # only for docker, otherwise leave empty
